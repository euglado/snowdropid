{
  "name": "snowdropid",
  "version": "1.0.0",
  "private": true,
  "description": "Private Discord ID creation-time reports with exact snowflake decoding",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "register": "node src/register.ts",
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "lint": "biome check .",
    "types": "tsc --noEmit",
    "supply": "node scripts/verify-supply.mjs",
    "check": "npm run lint && npm run types && npm test && npm run supply"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
